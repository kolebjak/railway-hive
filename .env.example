# Local end-to-end check only (`cp .env.example .env`). On Railway every value
# below is a template variable: secrets come from ${{secret()}}, URLs from
# ${{<service>.RAILWAY_PUBLIC_DOMAIN}}. See PUBLISHING.md.

HIVE_TAG=14.1.0

# Host ports. Change if taken (8080 often is).
APP_HOST_PORT=8080
USAGE_HOST_PORT=8081
SERVER_HOST_PORT=8082

# Public URLs the browser and the Hive CLI use. Must match the host ports above.
HIVE_APP_URL=http://localhost:8080
HIVE_SERVER_URL=http://localhost:8082

# Infrastructure credentials
POSTGRES_DB=registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=local-clickhouse-password
REDIS_PASSWORD=local-redis-password
S3_ACCESS_KEY=hiveadmin
S3_SECRET_KEY=local-s3-secret-key

# App secrets (template: hex via secret(); see PUBLISHING.md for exact calls)
HIVE_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef
CDN_AUTH_PRIVATE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SUPERTOKENS_REFRESH_TOKEN_KEY=1000:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
# RSA key; empty = generated on first boot by services/server (stored in a volume).
SUPERTOKENS_ACCESS_TOKEN_KEY=

# Optional
LOG_LEVEL=info
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.com
# Usage retention. Unset = Hive default (orgs limited to 7 days).
CLICKHOUSE_TTL_TABLES=
CLICKHOUSE_TTL_DAILY_MV_TABLES=
CLICKHOUSE_TTL_HOURLY_MV_TABLES=
CLICKHOUSE_TTL_MINUTELY_MV_TABLES=
